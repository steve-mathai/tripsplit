# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local embedded database (PGlite)
/.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tasteskill working files (screenshots); direction sheets are kept
/.taste-skill/inspect/
/.taste-skill/inspect*/
/.taste-skill/before/
/.taste-skill/after/
/.taste-skill/**/*.png
/.taste-skill/**/*.jpg

# secrets (secrets audit 2026-11-20)
.env
.env.*
!.env.example
*.key
*.local.md
.vercel/
