# Leave unset for local dev: the app uses an embedded PGlite database in ./.data.
# Set to your Neon connection string for production (and to run db:setup against Neon).
DATABASE_URL=

# Public URL of the deployed site, used for link previews (Open Graph). Defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
