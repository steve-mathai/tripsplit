# Leave unset for local dev: the app uses an embedded PGlite database in ./.data.
# Set to your Neon connection string for production (and to run db:setup against Neon).
DATABASE_URL=

# Public URL of the deployed site, used for link previews (Open Graph). Defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Secret salt for hashing client IPs in the rate limiter (any long random string). Set it in production.
# RATE_LIMIT_SALT=

# Set to 1 to make the demo trip (kochi-2026) read-only on any deployment. It is always read-only
# when VERCEL_ENV is production, so you only need this on a preview or a self-hosted server.
# DEMO_READ_ONLY=
